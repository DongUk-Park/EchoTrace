# Export these variables in your shell before running API-backed steps.
# The scripts do not automatically load this file.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
# Used by the parallel LLMRec generation scripts:
OPENAI_BASE_URL=https://api.openai.com/v1
ANTHROPIC_BASE_URL=https://api.anthropic.com
# Used by cold-item augmentation:
OPENAI_MODEL=gpt-4o
DATASET_NAME=yelp
